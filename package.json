{
  "name": "space",
  "version": "0.1.0",
  "private": true,
  "description": "Visual Collaboration Workspace",
  "scripts": {
    "dev:ui": "pnpm --filter @space/ui dev",
    "dev:services": "pnpm --filter @space/services dev",
    "dev": "pnpm run dev:ui & pnpm run dev:services",
    "build:ui": "pnpm --filter @space/ui build",
    "build:services": "pnpm --filter @space/services build",
    "build": "pnpm run build:ui & pnpm run build:services",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.4"
  }
}
